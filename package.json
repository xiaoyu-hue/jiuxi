  "description": "九溪 · 综合信息聚集地（AI 为主，热点新闻为辅）。本地优先的静态信息站。",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/fetch-feeds.mjs --write && node scripts/build-search-index.mjs && astro build && node scripts/fetch-feeds.mjs --inject",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@extractus/feed-extractor": "^8.0.3",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@formkit/auto-animate": "^0.8.4",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.3.8",
    "lenis": "^1.3.26",
    "tailwindcss": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5"
  }
