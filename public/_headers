# 九溪 · 安全响应头（Cloudflare Pages 生效；GitHub Pages 不支持 _headers，见 BaseLayout 的 meta 兜底）
# 说明：站内抓取需在 connect-src 放行 CORS 代理与 Hacker News；
# 组件样式与防闪烁脚本均为内联，故 style-src / script-src 保留 'unsafe-inline'。
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://cors.proxy.run https://api.codetabs.com https://api.allorigins.win https://corsproxy.io https://hn.algolia.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
