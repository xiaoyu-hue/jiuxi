---
// 九溪 · 设置与数据（纯前端，localStorage）
// 使用轻量 settings.ts（不含 Zod），避免生产 bundle 膨胀。
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import GlassCard from '../components/GlassCard.astro';
---

<BaseLayout title="九溪 · 设置与数据" description="主题、偏好与数据管理">
  <header class="page-head">
    <h2>设置与数据</h2>
    <p>所有设置仅保存在本机浏览器</p>
  </header>

  <GlassCard class="set-card">
    <h3>主题</h3>
    <ThemeSwitcher />
  </GlassCard>

  <GlassCard class="set-card">
    <h3>外观</h3>
    <label class="set-row">
      <span>降低动效</span>
      <input type="checkbox" id="reduce-motion" />
    </label>
    {/* 「磨砂强度」滑杆已移除（2026-10-15 审查 M8）：全站无 CSS 消费
        --glass-blur（报刊版式已去玻璃模糊），拖动无任何效果，属误导性 UI。
        settings.ts 的 glassBlur 字段暂时保留仅为兼容旧版导出 JSON 的导入。 */}
  </GlassCard>

  <GlassCard class="set-card">
    <h3>数据</h3>
    <div class="set-row">
      <span>导出设置与收藏</span>
      <button class="glass-btn" id="export-btn" type="button">导出 JSON</button>
    </div>
    <div class="set-row">
      <span>导入 JSON</span>
      <input type="file" id="import-file" accept="application/json" />
    </div>
    <div class="set-row">
      <span>清除资讯缓存</span>
      <button class="glass-btn" id="clear-btn" type="button">清除</button>
    </div>
  </GlassCard>

  <p id="set-toast" class="set-toast" role="status" aria-live="polite"></p>
</BaseLayout>

<script>
  import {
    getSettings,
    saveSettings,
    applySettings,
    exportData,
    importData,
    clearCaches,
  } from '../lib/settings';
  import { initMotion, stopMotion } from '../lib/motion';

  const settings = getSettings();
  const reduce = document.getElementById('reduce-motion') as HTMLInputElement | null;
  const toast = document.getElementById('set-toast');

  if (reduce) reduce.checked = settings.reduceMotion;
  applySettings(settings);

  // 动效状态与设置同步（2026-10-15 审查 L14）：
  // 勾选「降低动效」立即停掉在途动效，无需刷新页面；取消勾选重新初始化。
  function syncMotion(reduceMotion: boolean) {
    if (reduceMotion) stopMotion();
    else initMotion();
  }
  // 兜底：若进页面时设置就是「降低动效」，而之前某处已初始化过动效
  // （本页脚本与 BaseLayout 的初始化脚本同帧执行，顺序不定），此处再停一次保证生效。
  if (settings.reduceMotion) stopMotion();

  function showToast(msg: string) {
    if (!toast) return;
    toast.textContent = msg;
    toast.style.opacity = '1';
    setTimeout(() => {
      if (toast) toast.style.opacity = '0';
    }, 2200);
  }

  reduce?.addEventListener('change', () => {
    const s = getSettings();
    s.reduceMotion = !!reduce.checked;
    saveSettings(s);
    applySettings(s);
    syncMotion(s.reduceMotion);
  });

  document.getElementById('export-btn')?.addEventListener('click', () => {
    const blob = new Blob([exportData()], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'jiuxi-data.json';
    a.click();
    URL.revokeObjectURL(url);
    showToast('已导出 jiuxi-data.json');
  });

  document.getElementById('import-file')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      const ok = importData(String(reader.result));
      if (ok) {
        const s = getSettings();
        if (reduce) reduce.checked = s.reduceMotion;
        applySettings(s);
        syncMotion(s.reduceMotion);
        showToast('导入成功');
      } else {
        showToast('导入失败：文件格式不正确');
      }
    };
    reader.readAsText(file);
  });

  document.getElementById('clear-btn')?.addEventListener('click', async () => {
    clearCaches();
    // 同时清除 IndexedDB（仅 Chromium 内核；Firefox 静默失败）
    try {
      const db = await import('../lib/db').then((m) => m.openDB());
      for (const name of db.objectStoreNames) {
        db.transaction(name, 'readwrite').objectStore(name).clear();
      }
    } catch { /* ignore */ }
    showToast('资讯缓存已清除，下次访问将重新抓取');
  });

</script>

<style>
  .set-card {
    padding: 20px;
    margin-bottom: 14px;
  }
  .set-card h3 {
    margin: 0 0 12px;
    font-size: 1.15rem;
  }
  .set-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
  }
  .set-row span {
    font-size: 0.95rem;
  }

  /* 2026-10-15 审查 M9：
     1) role=status + aria-live=polite（标记上已加）：导出/导入/清缓存的
        结果对读屏软件可感知；
     2) 移动端避让：小屏底部有 TabBar（z-index 30），toast 原先 bottom:24px
        被压住完全不可见——抬到 TabBar 之上并加 safe-area 内边距；
     3) z-index 高于 TabBar，保证反馈不被遮挡。 */
  .set-toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--surface);
    color: var(--text-strong);
    padding: 10px 18px;
    border-radius: 14px;
    box-shadow: var(--glass-shadow);
    opacity: 0;
    transition: opacity 0.3s;
    border: 1px solid var(--glass-border);
    font-size: 0.9rem;
    z-index: 60;
    pointer-events: none;
  }
  @media (max-width: 768px) {
    .set-toast {
      bottom: calc(76px + env(safe-area-inset-bottom));
    }
  }
</style>
