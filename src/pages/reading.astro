---
// 九溪 · 读书推荐（策展卡片网格）
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanitizeUrl } from '../lib/security';

// 渲染每本书的正文（客观推荐语）为 HTML
const books = await Promise.all(
  (await getCollection('reading')).map(async (e) => {
    const { Content } = await render(e);
    return { id: e.id, data: e.data, Content };
  })
);
---

<BaseLayout title="九溪 · 读书推荐" description="值得一读的书">
  <header class="page-head">
    <h2>读书推荐</h2>
    <p>好书分享，持续收录。「在线阅读」指向微信读书或官方免费全文，可按需取用。</p>
  </header>

  <div class="book-grid">
    {
      books.map(({ id, data, Content }) => (
        <article class="glass book-card" id={id}>
          <h3>{data.title}</h3>
          {data.author && <p class="book-author">{data.author}</p>}
          {data.rating != null && (
            <p class="book-rating">
              {'★'.repeat(data.rating)}
              {'☆'.repeat(5 - data.rating)}
            </p>
          )}
          <span class="book-tag">{data.tag}</span>
          <div class="book-desc"><Content /></div>
          {data.link && (
            <a class="book-link" href={sanitizeUrl(data.link)} target="_blank" rel="noopener">
              在线阅读 →
            </a>
          )}
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
    margin-top: 16px;
  }
  .book-card {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .book-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .book-author {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .book-rating {
    margin: 0;
    color: var(--accent);
    letter-spacing: 2px;
  }
  .book-tag {
    align-self: flex-start;
    font-size: 0.75rem;
    padding: 2px 10px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--text-strong);
  }
  .book-desc {
    margin: 2px 0 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .book-desc :global(p) {
    margin: 0;
  }
  .book-link {
    margin-top: 4px;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.85rem;
  }
</style>
