---
// 九溪 · 候选策展台（作者视图）
//
// 把聚簇去重后的各板块最新候选集中展示，供作者筛选沉淀：
//   - 有空：逐条挑，认可的沉淀进 timeline / tools / reading；
//   - 没空：交自动流接管（高质量候选直接发布，门禁见 docs/feed-policy）。
//
// 优先读 D1 持久化的候选（/api/candidates，跨会话留痕）；D1 缺失/为空时回退
// 实时聚合端点（refreshFeedOnline，会写穿回填 D1），保证永不白屏。
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = ['ai', 'news', 'tech', 'gaming'] as const;
const labels: Record<string, string> = { ai: 'AI', news: '新闻', tech: '科技', gaming: '游戏' };
---

<BaseLayout title="九溪 · 候选策展台" description="聚簇去重后的候选资讯，供作者筛选沉淀">
  <header class="page-head">
    <h2>候选策展台</h2>
    <p>
      已聚簇去重的各板块最新候选（按独立信源数排热度）。有空就挑条目沉淀进
      时间线 / 工具箱 / 读书；没空可交自动流接管。
    </p>
    <a class="back-link" href="/">← 返回首页</a>
  </header>

  <div id="curate-root">
    {
      sections.map((s) => (
        <section class="curate-section">
          <h3>{labels[s]}</h3>
          <div class="feed-grid" id={`curate-${s}`} data-section={s} />
        </section>
      ))
    }
  </div>

  <script>
    import { refreshFeedOnline, renderItems, wireFavorites } from '../lib/feeds';
    const CANDIDATES_API = '/api/candidates';
    const sections = ['ai', 'news', 'tech', 'gaming'] as const;

    async function loadCandidates(s: string): Promise<any[] | null> {
      try {
        const res = await fetch(`${CANDIDATES_API}?section=${s}`);
        if (!res.ok) return null;
        const json = (await res.json()) as { items?: any[] };
        if (Array.isArray(json.items)) return json.items;
        return null;
      } catch {
        return null;
      }
    }

    async function fallback(s: string, el: HTMLElement) {
      try {
        const items = await refreshFeedOnline(s as any);
        if (!items.length) {
          el.innerHTML = '<p class="feed-meta">暂无候选</p>';
          return;
        }
        renderItems(el, items);
        wireFavorites(el);
      } catch {
        el.innerHTML = '<p class="feed-meta">加载失败，请稍后重试</p>';
      }
    }

    for (const s of sections) {
      const el = document.getElementById(`curate-${s}`) as HTMLElement | null;
      if (!el) continue;
      loadCandidates(s)
        .then((items) => {
          // D1 有候选 → 直接展示；否则回退实时聚合（该路径会写穿回填 D1）
          if (items && items.length) {
            renderItems(el, items);
            wireFavorites(el);
          } else {
            fallback(s, el);
          }
        })
        .catch(() => fallback(s, el));
    }
  </script>
</BaseLayout>

<style>
  .curate-section {
    margin: 1.5rem 0;
  }
  .curate-section h3 {
    font-size: 1.1rem;
    border-left: 3px solid var(--accent, #4f7cff);
    padding-left: 0.5rem;
  }
  .back-link {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--accent, #4f7cff);
  }
</style>
