---
// 九溪 · 候选策展台（作者视图）
//
// 把聚簇去重后的各板块最新候选集中展示，供作者筛选沉淀：
//   - 有空：逐条挑，认可的沉淀进 timeline / tools / reading；
//   - 没空：交自动流接管（高质量候选直接发布，门禁见 docs/feed-policy）。
//
// 读构建期内嵌的聚合 JSON（#jiuxi-feed-all）按板块展示候选，纯静态、零运行时 API。
// 候选即各板块最新资讯（已聚簇去重），供作者筛选沉淀。
// 板块列表从 feeds.json 派生（2026-10-15 扩容：4 → 15）。
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTION_META, SECTION_ORDER } from '../lib/sections';

const sections = SECTION_ORDER;
const labels = SECTION_META;
---

<BaseLayout title="九溪 · 候选策展台" description="聚簇去重后的候选资讯，供作者筛选沉淀">
  <header class="page-head">
    <h2>候选策展台</h2>
    <p>
      已聚簇去重的各板块最新候选（中文优先、按发布时间排序）。有空就挑条目沉淀进
      时间线 / 工具箱 / 读书；没空可交自动流接管。
    </p>
    <a class="back-link" href="/">← 返回首页</a>
  </header>

  <div id="curate-root">
    {
      sections.map((s) => (
        <section class="curate-section">
          <h3>{labels[s].label}</h3>
          <div class="feed-grid" id={`curate-${s}`} data-section={s} />
        </section>
      ))
    }
  </div>

  <script>
    import { renderItems, wireFavorites, cleanFeedItems, clusterItems } from '../lib/feeds';
    import { SECTION_ORDER } from '../lib/sections';
    const sections = SECTION_ORDER;

    const allScript = document.getElementById('jiuxi-feed-all');
    let allData: { sections?: Record<string, any[]> } = { sections: {} };
    if (allScript) {
      try {
        allData = JSON.parse(allScript.textContent ?? '{}');
      } catch {
        allData = { sections: {} };
      }
    }

    for (const s of sections) {
      const el = document.getElementById(`curate-${s}`) as HTMLElement | null;
      if (!el) continue;
      const items = cleanFeedItems(clusterItems(allData.sections?.[s] || []));
      if (items.length) {
        renderItems(el, items);
        wireFavorites(el);
      } else {
        el.innerHTML = '<p class="feed-meta">暂无候选</p>';
      }
    }
  </script>
</BaseLayout>

<style>
  .curate-section {
    margin: 1.5rem 0;
  }
  .curate-section h3 {
    font-size: 1.1rem;
    border-left: 3px solid var(--accent, #4f7cff);
    padding-left: 0.5rem;
  }
  .back-link {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--accent, #4f7cff);
  }
</style>
