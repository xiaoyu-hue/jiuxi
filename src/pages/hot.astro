---
// 九溪 · 全局热点榜（跨板块按独立信源数排序）
//
// 复用首页「今日热点」的合并排序逻辑，跨全部板块（2026-10-15 扩容：4 → 15，
// 板块列表从 feeds.json 派生），按「独立信源数（cluster_size）」降序展示全局热点；
// 顶部 Filters 可按板块筛选。D1（/api/candidates）为空时回退实时聚合，永不白屏。
import BaseLayout from '../layouts/BaseLayout.astro';
import Filters from '../components/Filters.astro';
import { SECTION_META, SECTION_ORDER } from '../lib/sections';

const SECTIONS = SECTION_ORDER.map((s) => ({ key: s, label: SECTION_META[s].label }));
---

<BaseLayout
  title="九溪 · 全局热点榜"
  description={`跨 ${SECTIONS.length} 个板块，按独立信源数排序的全局热点`}
>
  <header class="page-head">
    <h2>全局热点榜</h2>
    <p>跨板块聚合，多源交叉的同一事件越靠前，单一来源已限流不刷屏。点击板块可筛选。</p>
  </header>

  <Filters target="hot-grid" sections={SECTIONS} />

  <div class="feed-grid" id="hot-grid">
    <p class="feed-meta">正在加载全局热点…</p>
  </div>
</BaseLayout>

<script>
  import { refreshFeedOnline, renderItems, wireFavorites, rankByHeat } from '../lib/feeds';
  import { SECTION_ORDER } from '../lib/sections';

  // 与前端 Filters 同一来源（feeds.json 派生），避免两处漂移
  const SECTIONS = SECTION_ORDER;
  const grid = document.getElementById('hot-grid');

  // 渲染并给每张卡片写入 data-section（Filters 组件据此筛选）
  function renderTagged(container: HTMLElement, items: any[]) {
    renderItems(container, items);
    wireFavorites(container);
    const cards = container.querySelectorAll<HTMLElement>('.feed-card');
    items.forEach((it, i) => {
      const card = cards[i];
      if (card) card.dataset.section = it._section || '';
    });
  }

  async function loadHot() {
    if (!grid) return;
    const all: any[] = [];
    await Promise.all(
      SECTIONS.map(async (s) => {
        try {
          const res = await fetch(`/api/candidates?section=${s}`);
          if (res.ok) {
            const j = await res.json();
            if (Array.isArray(j.items)) {
              (j.items as any[]).forEach((it: any) => (it._section = s));
              all.push(...j.items);
            }
          }
        } catch {
          /* 单板块失败忽略，不阻断其它板块 */
        }
      }),
    );

    if (all.length) {
      renderTagged(grid, rankByHeat(all, 6).slice(0, 60));
      return;
    }

    // D1 为空 → 回退实时聚合（按板块逐次拉，可靠标注板块）
    const live: any[] = [];
    for (const s of SECTIONS) {
      const items = await refreshFeedOnline(s);
      items.forEach((it: any) => (it._section = s));
      live.push(...items);
    }
    if (live.length) {
      renderTagged(grid, rankByHeat(live, 6).slice(0, 60));
    } else {
      grid.innerHTML = '<p class="feed-meta">暂无热点，稍后再来。</p>';
    }
  }

  loadHot();
</script>
