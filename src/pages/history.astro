---
// 九溪 · 历史回顾页面
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="九溪 · 历史回顾" description="回顾九溪每日资讯快照，追踪信息变迁轨迹">
  <div class="history-page">
    <!-- 页面头部 -->
    <header class="page-header">
      <h2>历史回顾</h2>
      <p class="page-desc">追溯每日资讯变迁，记录信息时代的足迹</p>
    </header>

    <!-- 统计卡片 -->
    <section class="stats-section" id="stats-section">
      <div class="stat-card">
        <span class="stat-value" id="stat-days">0</span>
        <span class="stat-label">记录天数</span>
      </div>
      <div class="stat-card">
        <span class="stat-value" id="stat-items">0</span>
        <span class="stat-label">资讯总数</span>
      </div>
      <div class="stat-card">
        <span class="stat-value" id="stat-ai">0</span>
        <span class="stat-label">AI 资讯</span>
      </div>
      <div class="stat-card">
        <span class="stat-value" id="stat-news">0</span>
        <span class="stat-label">热点新闻</span>
      </div>
    </section>

    <!-- 筛选控制栏 -->
    <section class="filter-bar">
      <div class="filter-group">
        <label for="date-filter">日期范围：</label>
        <input type="date" id="date-from" class="date-input">
        <span class="date-separator">至</span>
        <input type="date" id="date-to" class="date-input">
      </div>
      <div class="filter-group">
        <label>板块筛选：</label>
        <select id="section-filter" class="filter-select">
          <option value="all">全部板块</option>
          <option value="ai">AI 前沿</option>
          <option value="news">热点新闻</option>
          <option value="tech">科技动态</option>
          <option value="gaming">游戏资讯</option>
        </select>
      </div>
      <button id="refresh-btn" class="btn-refresh">刷新历史</button>
    </section>

    <!-- 历史列表容器 -->
    <section class="history-list" id="history-list">
      <div class="loading-state">
        <span class="spinner"></span>
        <p>正在加载历史记录...</p>
      </div>
    </section>

    <!-- 空状态提示 -->
    <div class="empty-state" id="empty-state" style="display: none;">
      <div class="empty-icon">📭</div>
      <h3>暂无历史记录</h3>
      <p>历史数据将从首次资讯抓取后开始记录</p>
      <button id="clear-btn" class="btn-clear">清除缓存</button>
    </div>
  </div>
</BaseLayout>

<script src="/history-client.js" type="text/javascript"></script>

<style>
  .history-page { max-width: 1200px; margin: 0 auto; padding: 20px; }
  .page-header { text-align: center; margin-bottom: 30px; }
  .page-header h2 { font-size: 2rem; margin-bottom: 10px; color: var(--text-strong); }
  .page-desc { color: var(--text-muted); font-size: 1rem; }
  .stats-section { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; margin-bottom: 30px; }
  .stat-card { background: var(--surface); border-radius: 12px; padding: 20px; text-align: center; border: 1px solid var(--rule); transition: transform 0.2s, box-shadow 0.2s; }
  .stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-1); }
  .stat-value { display: block; font-size: 2rem; font-weight: 700; color: var(--accent); margin-bottom: 8px; }
  .stat-label { font-size: 0.875rem; color: var(--text-muted); }
  .filter-bar { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; background: var(--surface); padding: 16px; border-radius: 12px; margin-bottom: 24px; border: 1px solid var(--rule); }
  .filter-group { display: flex; align-items: center; gap: 8px; }
  .filter-group label { font-size: 0.875rem; color: var(--text-muted); white-space: nowrap; }
  .date-input { padding: 8px 12px; border: 1px solid var(--rule); border-radius: 8px; background: var(--bg-2); color: var(--text-strong); font-size: 0.875rem; }
  .date-separator { color: var(--text-muted); font-size: 0.875rem; }
  .filter-select { padding: 8px 12px; border: 1px solid var(--rule); border-radius: 8px; background: var(--bg-2); color: var(--text-strong); font-size: 0.875rem; cursor: pointer; }
  .btn-refresh { margin-left: auto; padding: 8px 16px; background: var(--accent); color: white; border: none; border-radius: 8px; font-size: 0.875rem; cursor: pointer; transition: opacity 0.2s; }
  .btn-refresh:hover { opacity: 0.9; }
  .history-list { display: flex; flex-direction: column; gap: 20px; }
  .history-date-group { background: var(--surface); border-radius: 12px; border: 1px solid var(--rule); overflow: hidden; }
  .date-header { padding: 16px 20px; background: var(--surface-2); border-bottom: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none; }
  .date-header:hover { opacity: 0.8; }
  .date-title { font-size: 1.1rem; font-weight: 600; color: var(--text-strong); display: flex; align-items: center; gap: 10px; }
  .date-badge { background: var(--accent-soft); color: var(--accent); padding: 4px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 500; }
  .date-meta { font-size: 0.875rem; color: var(--text-muted); }
  .history-items { padding: 16px 20px; }
  .section-group { margin-bottom: 20px; }
  .section-group:last-child { margin-bottom: 0; }
  .section-title { font-size: 0.9rem; font-weight: 600; color: var(--text-muted); margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--rule); display: flex; align-items: center; gap: 8px; }
  .section-title::before { content: ''; width: 4px; height: 16px; background: var(--accent); border-radius: 2px; }
  .item-list { display: flex; flex-direction: column; gap: 10px; }
  .history-item { display: flex; align-items: flex-start; gap: 12px; padding: 14px; border-radius: 8px; transition: background 0.2s; background: var(--bg-2); }
  .history-item:hover { background: var(--surface-2); }
  .item-number { font-size: 0.75rem; color: var(--text-muted); min-width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; background: var(--bg-2); border-radius: 4px; }
  .item-content { flex: 1; min-width: 0; }
  .item-title { font-size: 0.95rem; font-weight: 500; color: var(--text-strong); text-decoration: none; display: block; margin-bottom: 4px; line-height: 1.4; }
  .item-title:hover { color: var(--accent); }
  .item-meta { font-size: 0.8rem; color: var(--text-muted); display: flex; gap: 12px; }
  .item-source { background: var(--accent-soft); color: var(--accent); padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }
  .loading-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; gap: 16px; }
  .spinner { width: 40px; height: 40px; border: 3px solid var(--rule); border-top-color: var(--accent); border-radius: 50%; animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .loading-state p { color: var(--text-muted); font-size: 0.9rem; }
  .empty-state { text-align: center; padding: 60px 20px; }
  .empty-icon { font-size: 4rem; margin-bottom: 16px; }
  .empty-state h3 { font-size: 1.25rem; color: var(--text-strong); margin-bottom: 8px; }
  .empty-state p { color: var(--text-muted); margin-bottom: 20px; }
  .btn-clear { padding: 10px 20px; background: var(--accent-soft); color: var(--accent); border: none; border-radius: 8px; font-size: 0.9rem; cursor: pointer; transition: background 0.2s; }
  .btn-clear:hover { background: var(--accent); color: white; }
  .toggle-icon { transition: transform 0.3s; }
  .history-date-group.collapsed .toggle-icon { transform: rotate(-90deg); }
  .history-items { max-height: 2000px; overflow: hidden; transition: max-height 0.3s ease-out; }
  .history-date-group.collapsed .history-items { max-height: 0; }
  @media (max-width: 768px) {
    .filter-bar { flex-direction: column; align-items: stretch; }
    .filter-group { flex-wrap: wrap; }
    .btn-refresh { margin-left: 0; }
    .stats-section { grid-template-columns: repeat(2, 1fr); }
  }
</style>
