---
// 九溪 · 首页（Phase 1 临时 hero，Phase 2 替换为 Bento 聚合）
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="九溪">
  <section class="glass hero">
    <h1 class="hero-title">九溪</h1>
    <p class="hero-sub">综合信息聚集地</p>
    <p class="hero-tag">AI 为主 · 热点新闻为辅 · 建设中</p>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 560px;
    margin: 48px auto;
    padding: 48px 32px;
    text-align: center;
  }
  .hero-title {
    margin: 0;
    font-size: 3.2rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }
  .hero-sub {
    margin: 14px 0 6px;
    font-size: 1.2rem;
    font-weight: 600;
  }
  .hero-tag {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
</style>
