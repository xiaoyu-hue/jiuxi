---
// 九溪 · 首页聚合（Bento 卡片门户 + 今日热点模块）
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassCard from '../components/GlassCard.astro';
import JiuxiMark from '../components/JiuxiMark.astro';
import { withBase } from '../lib/site';

const blocks = [
  { href: '/ai', title: 'AI 板块', desc: 'AI 前沿资讯与动态聚合', span: 2 },
  { href: '/news', title: '热点新闻', desc: '实时热点，全球视角' },
  { href: '/tech', title: '科技', desc: '科技圈新进展' },
  { href: '/gaming', title: '游戏娱乐', desc: '游戏与泛娱乐' },
  { href: '/timeline', title: 'AI 发展时间线', desc: '从起源到今天' },
  { href: '/tools', title: 'AI 工具箱', desc: '好用的 AI 工具推荐' },
  { href: '/reading', title: '读书推荐', desc: '值得一读的书' },
  { href: '/history', title: '历史回顾', desc: '每日资讯快照，回看过去' },
  { href: '/settings', title: '设置与数据', desc: '主题、偏好与导出' },
  { href: '/about', title: '关于九溪', desc: '项目说明与致谢' },
];
---
<BaseLayout title="九溪">
  <header class="masthead">
    <h1 class="masthead-mark" aria-label="九溪">
      <JiuxiMark size={64} />
    </h1>
    <p class="masthead-lead">综合信息聚集地 · AI 为主，热点新闻为辅</p>
    <p class="masthead-date">
      {
        new Date().toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          weekday: 'long',
        })
      }
    </p>
    <p class="masthead-clock" id="masthead-clock" aria-label="当前时间">
      <span>--</span><span class="c">:</span><span>--</span><span class="c">:</span><span>--</span>
    </p>
  </header>

  <header class="feed-head">
    <h2>今日热点</h2>
    <p>聚合 AI · 新闻 · 科技 · 游戏 四板块热讯 · 多源交叉的同一事件置顶</p>
  </header>
  <div class="feed-grid" id="home-hot">
    <p class="feed-meta">正在加载今日热点…</p>
  </div>

  <div class="bento">
    {
      blocks.map((b) => (
        <GlassCard href={withBase(b.href)} class:list={['bento-card', b.span === 2 && 'span-2']}>
          <h3>{b.title}</h3>
          <p>{b.desc}</p>
        </GlassCard>
      ))
    }
  </div>
</BaseLayout>

<script>
  import { renderItems, wireFavorites, refreshFeedOnline, cleanFeedItems, rankByHeat } from '../lib/feeds';

  const SECTIONS = ['ai', 'news', 'tech', 'gaming'] as const;
  const el = document.getElementById('home-hot');

  async function loadHot() {
    if (!el) return;
    const root = el;
    const raw: unknown[] = [];
    await Promise.all(
      SECTIONS.map(async (s) => {
        try {
          const res = await fetch(`/api/candidates?section=${s}`);
          if (res.ok) {
            const j = await res.json();
            if (Array.isArray(j.items)) raw.push(...j.items);
          }
        } catch {
          /* 单板块失败忽略 */
        }
      }),
    );
    const items = cleanFeedItems(raw);
    if (items.length) {
      renderItems(root, rankByHeat(items, 3).slice(0, 10));
      wireFavorites(root);
    } else {
      // D1 为空时回退实时聚合（同 /curate 逻辑），永不白屏
      const live = cleanFeedItems((await Promise.all(SECTIONS.map((s) => refreshFeedOnline(s)))).flat());
      if (live.length) {
        renderItems(root, rankByHeat(live, 3).slice(0, 10));
        wireFavorites(root);
      } else {
        root.innerHTML = '<p class="feed-meta">暂无热点，稍后再来。</p>';
      }
    }
  }

  loadHot();

  const clk = document.getElementById('masthead-clock');
  function tickClock() {
    if (!clk) return;
    const d = new Date();
    const pad = (n: number) => String(n).padStart(2, '0');
    const spans = clk.querySelectorAll('span:not(.c)');
    if (spans.length === 3) {
      spans[0].textContent = pad(d.getHours());
      spans[1].textContent = pad(d.getMinutes());
      spans[2].textContent = pad(d.getSeconds());
    }
  }
  tickClock();
  setInterval(tickClock, 1000);
</script>

<style>
  .masthead-clock {
    margin-top: 6px;
    font-family: var(--font-mono, monospace);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.2em;
    color: var(--text-soft);
    font-size: 1rem;
  }
  .masthead-clock .c {
    margin: 0 2px;
    animation: colon-breathe 2s ease-in-out infinite;
  }
  @keyframes colon-breathe {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .masthead-clock .c { animation: none; opacity: 0.8; }
  }
  .bento {
    margin: 44px 0 8px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .bento-card h3 {
    margin: 0 0 8px;
    font-size: var(--fs-card);
  }
  .bento-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .span-2 {
    grid-column: span 2;
  }
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(3, 1fr);
    }
    .span-2 {
      grid-column: span 2;
    }
  }
</style>
