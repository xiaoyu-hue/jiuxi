---
// 九溪 · 首页聚合（Bento 卡片门户 + 今日热点模块）
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassCard from '../components/GlassCard.astro';
import JiuxiMark from '../components/JiuxiMark.astro';
import { withBase } from '../lib/site';
import { SECTION_META, SECTION_ORDER } from '../lib/sections';

// 板块卡片：从 feeds.json 派生（15 个，AI 保持 span-2 大卡突出主打定位）
interface Block {
  href: string;
  title: string;
  desc: string;
  /** 2 = 跨两列大卡；0/省略 = 普通卡 */
  span?: number;
}
const sectionBlocks: Block[] = SECTION_ORDER.map((s) => ({
  href: `/${s}`,
  title: `${SECTION_META[s].label}板块`,
  desc: SECTION_META[s].desc,
  span: s === 'ai' ? 2 : 0,
}));
// 功能卡片：固定入口
const featureBlocks: Block[] = [
  { href: '/timeline', title: 'AI 发展时间线', desc: '从起源到今天' },
  { href: '/tools', title: 'AI 工具箱', desc: '好用的 AI 工具推荐' },
  { href: '/reading', title: '读书推荐', desc: '值得一读的书' },
  { href: '/settings', title: '设置与数据', desc: '主题、偏好与导出' },
  { href: '/about', title: '关于九溪', desc: '项目说明与致谢' },
];
const blocks = [...sectionBlocks, ...featureBlocks];
---
<BaseLayout title="九溪">
  <header class="masthead">
    <h1 class="masthead-mark" aria-label="九溪">
      <JiuxiMark size={64} />
    </h1>
    <p class="masthead-lead">综合信息聚集地 · AI 为主，热点新闻为辅</p>
    <p class="masthead-date">
      {
        new Date().toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          weekday: 'long',
        })
      }
    </p>
    <p class="masthead-clock" id="masthead-clock" aria-label="当前时间">
      <span>--</span><span class="c">:</span><span>--</span><span class="c">:</span><span>--</span>
    </p>
  </header>

  <header class="feed-head">
    <h2>今日热点</h2>
    <p>聚合 {SECTION_ORDER.length} 个板块 · 中文资讯优先，按发布时间实时排序</p>
  </header>
  <div class="feed-grid" id="home-hot">
    <p class="feed-meta">正在加载今日热点…</p>
  </div>

  <div class="bento">
    {
      blocks.map((b) => (
        <GlassCard href={withBase(b.href)} class:list={['bento-card', b.span === 2 && 'span-2']}>
          <h3>{b.title}</h3>
          <p>{b.desc}</p>
        </GlassCard>
      ))
    }
  </div>
</BaseLayout>

<script>
  import { renderItems, wireFavorites, cleanFeedItems, rankZhFirst, enQuotaFor, clusterItems } from '../lib/feeds';
  import { SECTION_ORDER } from '../lib/sections';

  // 今日热点覆盖全部板块（2026-10-15 扩容：4 → 15，与 feeds.json 联动派生）。
  // 数据来自构建期内嵌的聚合 JSON（#jiuxi-feed-all），纯静态、零运行时 API。
  const SECTIONS = SECTION_ORDER;
  const el = document.getElementById('home-hot');

  function loadHot() {
    if (!el) return;
    const script = document.getElementById('jiuxi-feed-all');
    if (!script) {
      el.innerHTML = '<p class="feed-meta">暂无热点，稍后再来。</p>';
      return;
    }
    let data: { sections?: Record<string, any[]> };
    try {
      data = JSON.parse(script.textContent ?? '{}');
    } catch {
      el.innerHTML = '<p class="feed-meta">暂无热点，稍后再来。</p>';
      return;
    }
    const sections = data.sections || {};
    const all = SECTIONS.flatMap((s) => (sections[s] || []) as any[]);
    const items = cleanFeedItems(clusterItems(all));
    if (items.length) {
      renderItems(el, rankZhFirst(items, 10, enQuotaFor(10)));
      wireFavorites(el);
    } else {
      el.innerHTML = '<p class="feed-meta">暂无热点，稍后再来。</p>';
    }
  }

  loadHot();

  const clk = document.getElementById('masthead-clock');
  function tickClock() {
    if (!clk) return;
    const d = new Date();
    const pad = (n: number) => String(n).padStart(2, '0');
    const spans = clk.querySelectorAll('span:not(.c)');
    if (spans.length === 3) {
      spans[0].textContent = pad(d.getHours());
      spans[1].textContent = pad(d.getMinutes());
      spans[2].textContent = pad(d.getSeconds());
    }
  }
  tickClock();
  // 2026-10-15 审查：astro:transitions 换页后本 script 会重跑，不清定时器
  // 会导致多个 interval 叠加（每导航一次多一个秒级定时器）。换页前统一清理。
  const clockTimer = setInterval(tickClock, 1000);
  document.addEventListener('astro:before-swap', () => clearInterval(clockTimer), {
    once: true,
  });
</script>

<style>
  /* 2026-10-15 审查 M15：原内距 2px 10px ≈ 21px 高，远低于 WCAG 2.5.5 的 44px。
     标题行内按钮不宜直接撑高（破坏版式），用透明 ::before 扩展命中区 */
  .refresh-hot { position: relative; font: inherit; font-size: .78rem; margin-left: 8px; color: var(--accent); background: var(--bg-2); border: 1px solid var(--rule); border-radius: 8px; padding: 2px 10px; cursor: pointer; vertical-align: middle; transition: background .15s, opacity .15s; }
  .refresh-hot::before { content: ''; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 44px; height: 44px; border-radius: 8px; }
  .refresh-hot:hover { background: var(--rule); }
  .refresh-hot:disabled { opacity: .5; cursor: default; }
  .refresh-hot:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .masthead-clock {
    margin-top: 6px;
    font-family: var(--font-mono, monospace);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    font-size: 1rem;
  }
  .masthead-clock .c {
    margin: 0 2px;
    animation: colon-breathe 2s ease-in-out infinite;
  }
  @keyframes colon-breathe {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .masthead-clock .c { animation: none; opacity: 0.8; }
  }
  .bento {
    margin: 44px 0 8px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .bento-card h3 {
    margin: 0 0 8px;
    font-size: var(--fs-card);
  }
  .bento-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .span-2 {
    grid-column: span 2;
  }
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(3, 1fr);
    }
    .span-2 {
      grid-column: span 2;
    }
  }
</style>
