---
// 九溪 · 主题切换器（4 套主题圆点）
//
// 2026-10-15 审查 M10/M15：圆点原先用蓝粉渐变（DESIGN.md 明令禁用渐变），
// 且不代表各主题真实配色。改为「该主题 --bg 底 + --accent 中心点」——
// 与 JiuxiMark 母题（外环 currentColor、中心 var(--accent)）同构，预览即所得。
// 配色引用 themes.css 的 --t-<name>-bg / --t-<name>-accent 基准色（单一真相源，
// 切主题时圆点不变——圆点是「预览」，展示各主题自己的配色）。
// 视觉尺寸保持 22px 的版式比例，触控目标用透明 ::before 扩展到 44px
// （WCAG 2.5.5），兼顾版式与可达性。
import { THEMES } from '../lib/theme';
---

<div class="theme-switcher" role="group" aria-label="主题切换">
  {
    THEMES.map((t) => (
      <button
        type="button"
        class="theme-dot"
        data-theme-name={t.name}
        title={t.label}
        aria-label={`切换到${t.label}主题`}
      />
    ))
  }
</div>

<script>
  import { THEMES, applyTheme, getStoredTheme, type ThemeName } from '../lib/theme';

  // 站点开了视图过渡（ClientRouter）：换页时页头 DOM 会被重建，组件 <script> 不会重跑，
  // 若不重新绑定，首次导航后圆点会失去点击监听，主题切换「看起来没了」。
  // 因此把绑定挂到 astro:page-load（首次加载与每次换页后都会触发）。
  function bindThemeSwitcher() {
    // 优先读已存偏好；空白时回退到防闪烁脚本已写入 <html data-theme> 的真实生效主题，保证高亮正确
    const stored = getStoredTheme() ?? (document.documentElement.getAttribute('data-theme') as ThemeName | null);
    const dots = document.querySelectorAll<HTMLButtonElement>('.theme-dot');

    dots.forEach((btn) => {
      const name = btn.dataset.themeName as (typeof THEMES)[number]['name'];
      // aria-pressed 反映「当前选中」，比仅靠 .active 类更利于读屏软件（M10）
      btn.setAttribute('aria-pressed', name === stored ? 'true' : 'false');
      if (name === stored) btn.classList.add('active');
      btn.addEventListener('click', () => {
        applyTheme(name);
        dots.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
      });
    });
  }

  document.addEventListener('astro:page-load', bindThemeSwitcher);
</script>

<style>
  .theme-switcher {
    display: inline-flex;
    gap: 10px;
    align-items: center;
  }
  .theme-dot {
    position: relative;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--glass-border);
    cursor: pointer;
    padding: 0;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  /* 触控目标扩展到 44×44（WCAG 2.5.5）：透明 ::before 撑大命中区，视觉尺寸不变 */
  .theme-dot::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .theme-dot.active {
    transform: scale(1.18);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .theme-dot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* 各主题真实配色预览（径向渐变仅用于「圆点中心」这一处功能性图形，
     非 DESIGN.md 禁用的装饰性多色渐变） */
  .theme-dot[data-theme-name='chenxi'] {
    background: radial-gradient(circle at center, var(--t-chenxi-accent) 0 4.5px, transparent 4.5px),
      var(--t-chenxi-bg);
  }
  .theme-dot[data-theme-name='midnight'] {
    background: radial-gradient(circle at center, var(--t-midnight-accent) 0 4.5px, transparent 4.5px),
      var(--t-midnight-bg);
  }
  .theme-dot[data-theme-name='aurora'] {
    background: radial-gradient(circle at center, var(--t-aurora-accent) 0 4.5px, transparent 4.5px),
      var(--t-aurora-bg);
  }
  .theme-dot[data-theme-name='sakura'] {
    background: radial-gradient(circle at center, var(--t-sakura-accent) 0 4.5px, transparent 4.5px),
      var(--t-sakura-bg);
  }
</style>
