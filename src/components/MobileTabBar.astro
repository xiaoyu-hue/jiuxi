---
// 九溪 · 移动端底部 TabBar（仅小屏显示，桌面隐藏）
//
// 固定底部：首页 / 热点 / 工具 / 我的。「我的」展开底部 sheet，
// 含 收藏 / 搜索 / 设置 / 关于。搜索按钮派发 jiuxi:open-search 事件，
// 由 SearchOverlay 接收打开搜索浮层。
// 通过事件委托绑定，兼容 astro:transitions 换页后节点重建。
import { withBase } from '../lib/site';

const path = Astro.url.pathname;

// 内联 SVG 线性图标（零依赖、跨平台渲染一致，规避 Astro 7 集成兼容风险）
const icons = {
  home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20h14V9.5"/><path d="M9.5 20v-6h5v6"/></svg>',
  hot: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>',
  tools: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>',
  user: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg>',
  star: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z"/></svg>',
  search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>',
  settings: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
  info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>',
};

const tabs = [
  { href: '/', label: '首页', icon: icons.home },
  { href: '/hot', label: '热点', icon: icons.hot },
  { href: '/tools', label: '工具', icon: icons.tools },
];
const moreActive = ['/starred', '/settings', '/about', '/search'].some(
  (p) => path === withBase(p) || path.startsWith(withBase(p) + '/'),
);

const isActive = (href: string) =>
  href === '/' ? path === withBase('/') : path.startsWith(withBase(href));
---

<nav class="tabbar" aria-label="移动端导航">
  {
    tabs.map((t) => (
      <a
        class:list={['tabbar-item', { active: isActive(t.href) }]}
        href={withBase(t.href)}
        aria-current={isActive(t.href) ? 'page' : undefined}
      >
        <span class="tabbar-icon" aria-hidden="true" set:html={t.icon}></span>
        <span class="tabbar-label">{t.label}</span>
      </a>
    ))
  }
  <button
    type="button"
    class:list={['tabbar-item', 'tabbar-more', { active: moreActive }]}
    id="tabbar-more"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <span class="tabbar-icon" aria-hidden="true" set:html={icons.user}></span>
    <span class="tabbar-label">我的</span>
  </button>
</nav>

<div
  class="tabbar-sheet"
  id="tabbar-sheet"
  role="dialog"
  aria-modal="true"
  aria-label="更多"
  hidden
>
  <div class="tabbar-sheet-backdrop" data-close></div>
  <div class="tabbar-sheet-panel glass">
    <div class="tabbar-sheet-head">
      <span>我的九溪</span>
      <button type="button" class="tabbar-sheet-close" data-close aria-label="关闭">×</button>
    </div>
    <a class="tabbar-sheet-link" href={withBase('/starred')}>
      <span class="ssl-icon" aria-hidden="true" set:html={icons.star}></span>
      <span>收藏</span>
    </a>
    <button type="button" class="tabbar-sheet-link" id="tabbar-search">
      <span class="ssl-icon" aria-hidden="true" set:html={icons.search}></span>
      <span>搜索</span>
    </button>
    <a class="tabbar-sheet-link" href={withBase('/settings')}>
      <span class="ssl-icon" aria-hidden="true" set:html={icons.settings}></span>
      <span>设置</span>
    </a>
    <a class="tabbar-sheet-link" href={withBase('/about')}>
      <span class="ssl-icon" aria-hidden="true" set:html={icons.info}></span>
      <span>关于</span>
    </a>
  </div>
</div>

<style>
  /* 默认（桌面）隐藏；仅小屏显示，避免与分组主导航重复 */
  .tabbar {
    display: none;
  }
  @media (max-width: 768px) {
    .tabbar {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      justify-content: space-around;
      background: var(--glass-bg);
      backdrop-filter: blur(12px);
      border-top: 1px solid var(--glass-border);
      padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
    }
  }
  .tabbar-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    min-height: 44px; /* WCAG 2.5.5 触控目标下限 */
    flex: 1;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-sans);
    padding: 4px 0;
    border-radius: 14px;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .tabbar-icon {
    display: grid;
    place-items: center;
    line-height: 1;
  }
  .tabbar-icon svg {
    width: 22px;
    height: 22px;
    display: block;
  }
  .tabbar-label {
    font-size: 0.72rem;
    line-height: 1;
  }
  .tabbar-item.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* ── 我的 sheet（底部弹层）── */
  .tabbar-sheet[hidden] {
    display: none;
  }
  .tabbar-sheet {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    align-items: flex-end;
  }
  .tabbar-sheet-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
  }
  .tabbar-sheet-panel {
    position: relative;
    width: 100%;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tabbar-sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  .tabbar-sheet-close {
    position: relative;
    background: none;
    border: none;
    font-size: 1.4rem;
    color: var(--text-muted);
    cursor: pointer;
    line-height: 1;
  }
  /* M15：透明 ::before 扩展触控目标至 44px */
  .tabbar-sheet-close::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .tabbar-sheet-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 50%;
  }
  .tabbar-sheet-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 8px;
    border-radius: 10px;
    color: var(--text-strong);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 1rem;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    width: 100%;
  }
  .ssl-icon {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--accent);
  }
  .ssl-icon svg {
    width: 20px;
    height: 20px;
    display: block;
  }
  .tabbar-sheet-link:hover {
    background: var(--accent-soft);
  }
</style>

<script>
  import { trapFocus } from '../lib/trap-focus';

  // 通过事件委托绑定（兼容 astro:transitions 换页后节点重建），全局只绑一次
  if (!(window as any).__jiuxiTabbarBound) {
    (window as any).__jiuxiTabbarBound = true;

    const $sheet = () => document.getElementById('tabbar-sheet');
    const $more = () => document.getElementById('tabbar-more');
    // 焦点圈定 handle（2026-10-15 审查 M6/M7：sheet 声明 aria-modal 但 Tab 可穿出）
    let sheetTrap: ReturnType<typeof trapFocus> | null = null;

    const openSheet = () => {
      const s = $sheet();
      const m = $more();
      if (!s || !m) return;
      s.hidden = false;
      m.setAttribute('aria-expanded', 'true');
      document.body.classList.add('sheet-open');
      // 重复打开前先释放旧 trap；trap 自动聚焦首个可聚焦元素（关闭按钮）
      sheetTrap?.release();
      sheetTrap = trapFocus(s);
    };
    const closeSheet = () => {
      const s = $sheet();
      const m = $more();
      if (!s || !m) return;
      s.hidden = true;
      m.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('sheet-open');
      sheetTrap?.release();
      sheetTrap = null;
    };
    const toggleSheet = () => {
      const s = $sheet();
      if (!s) return;
      if (s.hidden) openSheet();
      else closeSheet();
    };

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('#tabbar-more')) {
        toggleSheet();
      } else if (t.closest('#tabbar-search')) {
        closeSheet();
        window.dispatchEvent(new CustomEvent('jiuxi:open-search'));
      } else if (t.closest('[data-close]') && t.closest('.tabbar-sheet')) {
        closeSheet();
      }
    });
    document.addEventListener('keydown', (e) => {
      const s = $sheet();
      if (e.key === 'Escape' && s && !s.hidden) closeSheet();
    });
    document.addEventListener('astro:after-swap', closeSheet);
  }
</script>
