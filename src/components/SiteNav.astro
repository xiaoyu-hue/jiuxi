---
// 九溪 · 主导航（4 个高频页常驻 + 原生「更多 ▾」收纳其余；小屏隐藏，由底部 TabBar 承载）
import { withBase } from '../lib/site';
import { SECTION_META, SECTION_ORDER } from '../lib/sections';

// 常驻高频（认知负荷最低的 4 个）
const primary = [
  { href: '/', label: '首页' },
  { href: '/ai', label: 'AI' },
  { href: '/hot', label: '热点' },
  { href: '/tech', label: '科技' },
];
// 「更多」面板 · 板块组：从 feeds.json 派生（15 个，新增板块自动进导航）
const sectionLinks = SECTION_ORDER.map((s) => ({
  href: `/${s}`,
  label: SECTION_META[s].label,
}));
// 「更多」面板 · 功能组：固定功能入口
const featureLinks = [
  { href: '/history', label: '历史回顾' },
  { href: '/timeline', label: '时间线' },
  { href: '/tools', label: '工具箱' },
  { href: '/reading', label: '读书' },
  { href: '/starred', label: '收藏' },
  { href: '/settings', label: '设置' },
  { href: '/about', label: '关于' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === withBase('/') : path.startsWith(withBase(href));
const moreActive = [...sectionLinks, ...featureLinks].some((l) => isActive(l.href));
---

<nav class="site-nav glass" aria-label="主导航">
  <div class="nav-row">
    {
      primary.map((l) => (
        <a
          href={withBase(l.href)}
          class:list={['nav-link', 'primary', { active: isActive(l.href) }]}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))
    }
    <details class="nav-more">
      <summary
        class:list={['nav-link', 'nav-more-summary', { active: moreActive }]}
      >
        更多
      </summary>
      <div class="nav-more-panel">
        <div class="nav-group">
          <span class="nav-group-title">板块</span>
          {sectionLinks.map((l) => (
            <a
              href={withBase(l.href)}
              class:list={['nav-link', { active: isActive(l.href) }]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          ))}
        </div>
        <div class="nav-group">
          <span class="nav-group-title">功能</span>
          {featureLinks.map((l) => (
            <a
              href={withBase(l.href)}
              class:list={['nav-link', { active: isActive(l.href) }]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          ))}
        </div>
      </div>
    </details>
  </div>
</nav>

<style>
  .site-nav {
    margin: 0 12px 12px;
    padding: 10px 14px;
  }
  .nav-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .nav-link {
    display: block;
    padding: 8px 14px;
    border-radius: 14px;
    white-space: nowrap;
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.92rem;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .nav-link.primary {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-strong);
  }
  .nav-link:hover {
    color: var(--text-strong);
    background: var(--accent-soft);
  }
  .nav-link.active {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }
  /* 「更多」：原生 <details>，零 JS、可访问；面板绝对定位悬浮 */
  .nav-more {
    position: relative;
  }
  .nav-more-summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
  }
  .nav-more-summary::-webkit-details-marker {
    display: none;
  }
  .nav-more-summary::after {
    content: ' ▸';
    font-size: 0.7em;
  }
  .nav-more[open] .nav-more-summary::after {
    content: ' ▾';
  }
  /* 面板内部分「板块 / 功能」两组（15 板块扩容后单组 22 条过长，分组降认知负荷） */
  .nav-more-panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 240px;
    max-width: min(560px, 86vw);
    max-height: min(70vh, 520px);
    overflow-y: auto;
    padding: 10px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--rule);
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.14);
  }
  .nav-group {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .nav-group-title {
    flex-basis: 100%;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 0 4px;
  }
  .nav-more-panel .nav-link {
    font-size: 0.9rem;
  }
  /* 小屏由底部 TabBar 承载，隐藏分组主导航 */
  @media (max-width: 768px) {
    .site-nav {
      display: none;
    }
  }
</style>
