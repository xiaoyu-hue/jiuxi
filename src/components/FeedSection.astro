---
// 九溪 · 动态资讯板块（内置预渲染数据 + 客户端刷新）
//
// 数据加载优先级：
//   1) <script type="application/json"> 内嵌数据（构建时注入，页面秒开）
//   2) IndexedDB 持久化缓存（上次在线获取的）
//   3) localStorage 缓存
//   4) 在线抓取（后台刷新）
//
// 用法：<FeedSection section="ai" title="AI 板块" description="..." showRefresh />
// 数据由 scripts/fetch-feeds.mjs 在构建后注入 HTML。
// showRefresh：是否显示显式「立即刷新」按钮（2026-10-15 渐进试点：仅 ai/tech
// 开，线上验证 Cloudflare 50 subrequest 上限与响应时间无问题后全量）。
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Section } from '../lib/feeds';

interface Props {
  section: Section;
  title: string;
  description?: string;
  showRefresh?: boolean;
}
const { section, title, description = '', showRefresh = false } = Astro.props;
---

<BaseLayout title={`九溪 · ${title}`} description={description}>
  <header class="page-head">
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="feed-status" id={`status-${section}`}>正在加载最新资讯…</div>
  </header>
  <div class="feed-skeleton" id={`skeleton-${section}`} aria-hidden="true">
    {
      Array.from({ length: 5 }).map(() => (
        <div class="sk-card">
          <div class="sk-block sk-kicker"></div>
          <div class="sk-block sk-title"></div>
          <div class="sk-block sk-meta"></div>
          <div class="sk-block sk-snippet"></div>
          <div class="sk-block sk-snippet short"></div>
        </div>
      ))
    }
  </div>
  <div class="feed-grid" id={`feed-${section}`} data-section={section}></div>
</BaseLayout>

<style>
  /* 与首页 .refresh-hot 同构：44px 透明命中区（WCAG 2.5.5），视觉保持小按钮 */
  .refresh-btn {
    position: relative;
    font: inherit;
    font-size: 0.78rem;
    margin-left: 8px;
    color: var(--accent);
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 2px 10px;
    cursor: pointer;
    vertical-align: middle;
    transition: background 0.15s, opacity 0.15s;
  }
  .refresh-btn::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 8px;
  }
  .refresh-btn:hover {
    background: var(--rule);
  }
  .refresh-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .refresh-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

<script>
  import { renderItems, wireFavorites } from '../lib/feeds';
  import type { Section } from '../lib/sections';

  // 纯静态：直接渲染构建期内嵌的 JSON（scripts/fetch-feeds.mjs 注入），零运行时请求。
  document.querySelectorAll<HTMLElement>('.feed-grid').forEach((el) => {
    const section = el.dataset.section as any;
    const status = document.getElementById(`status-${section}`);
    const skeleton = document.getElementById(`skeleton-${section}`);
    const script = document.getElementById(`jiuxi-feed-${section}`);
    try {
      const items = script ? (JSON.parse(script.textContent ?? '[]') as any[]) : [];
      if (items.length) {
        renderItems(el, items);
        wireFavorites(el);
        if (status) status.textContent = `已加载 · ${new Date().toLocaleString('zh-CN')}`;
        if (skeleton) skeleton.hidden = true;
        return;
      }
    } catch {
      /* 解析失败，走下方空态 */
    }
    if (skeleton) skeleton.hidden = true;
    if (status) status.textContent = '暂无可展示的资讯';
  });
</script>
