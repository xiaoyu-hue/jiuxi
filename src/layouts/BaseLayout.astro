---
// 九溪 · 基础布局（报刊版式 + 主题系统 + 导航 + 视图过渡）
import '../styles/global.css';
import '../styles/themes.css';
import '../styles/glass.css';
import '../styles/components.css';
import { ClientRouter } from 'astro:transitions';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import SiteNav from '../components/SiteNav.astro';
import MobileTabBar from '../components/MobileTabBar.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import { withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '九溪',
  description = '九溪 · 综合信息聚集地（AI 为主，热点新闻为辅）',
} = Astro.props;

// 规范地址与社交分享图（绝对地址，依赖 astro.config 的 site + base）
const canonicalURL = Astro.url;
const ogImageURL = new URL(withBase('/og-image.png'), Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- 规范地址（避免双站内容重复被搜索引擎误判） -->
    <link rel="canonical" href={canonicalURL.href} />
    <!-- Open Graph / 社交分享预览 -->
    <meta property="og:site_name" content="九溪" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <!-- RSS 订阅 -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="九溪 · 更新"
      href={withBase('/rss.xml')}
    />
    <!-- 安全响应头兜底（GitHub Pages 不读 _headers，故此处用 meta 覆盖） -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://hn.algolia.com; base-uri 'self'; form-action 'self'"
    />
    <!-- 防闪烁：CSS 加载前先按已存主题（或系统偏好）设置 data-theme -->
    <script is:inline>
      (function () {
        try {
          let t = localStorage.getItem('jiuxi-theme');
          if (!t) {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'midnight'
              : 'chenxi';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch {
          /* 隐私模式等无法读取 localStorage 时忽略 */
        }
      })();
    </script>
    <!-- 视图过渡：页面间淡入（尊重 prefers-reduced-motion） -->
    <ClientRouter />
  </head>
  <body>
    <header class="site-header glass">
      <a class="brand" href={withBase('/')}>九溪</a>
      <div class="site-header-actions">
        <button
          type="button"
          class="header-search"
          id="header-search"
          aria-label="搜索"
          title="搜索（/ 或 Cmd/Ctrl+K）"
        >🔍</button>
        <ThemeSwitcher />
      </div>
    </header>
    <SiteNav />
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">九溪 · 综合信息聚集地</footer>
    <MobileTabBar />
    <SearchOverlay />

    <!-- 克制动效初始化（滚动渐显 / 卡片流过渡 / 平滑滚动），详见 src/lib/motion.ts -->
    <script>
      import { initMotion } from '../lib/motion';
      const start = () => initMotion();
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
      // astro:transitions 换页后重新绑定动效
      document.addEventListener('astro:after-swap', start);
    </script>
    <!-- 顶部搜索按钮 → 派发 jiuxi:open-search（由 SearchOverlay 接收） -->
    <script>
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('#header-search')) {
          window.dispatchEvent(new CustomEvent('jiuxi:open-search'));
        }
      });
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
  }
  body {
    min-height: 100vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 12px;
    padding: 10px 18px;
  }
  .brand {
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: 0.12em;
    color: var(--text-strong);
    text-decoration: none;
  }
  .site-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .header-search {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1rem;
    display: grid;
    place-items: center;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .header-search:hover {
    color: var(--text-strong);
    border-color: var(--accent);
  }
  .site-main {
    flex: 1;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 16px 32px;
    box-sizing: border-box;
  }
  .site-footer {
    text-align: center;
    padding: 20px;
    color: var(--text-muted);
    font-size: 0.8rem;
  }
</style>
