---
// 九溪 · 基础布局（液态玻璃外壳 + 主题系统 + 导航）
import '../styles/global.css';
import '../styles/themes.css';
import '../styles/glass.css';
import '../styles/components.css';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import SiteNav from '../components/SiteNav.astro';
import { withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '九溪',
  description = '九溪 · 综合信息聚集地（AI 为主，热点新闻为辅）',
} = Astro.props;

// 规范地址与社交分享图（绝对地址，依赖 astro.config 的 site + base）
const canonicalURL = Astro.url;
const ogImageURL = new URL(withBase('/og-image.png'), Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- 规范地址（避免双站内容重复被搜索引擎误判） -->
    <link rel="canonical" href={canonicalURL.href} />
    <!-- Open Graph / 社交分享预览 -->
    <meta property="og:site_name" content="九溪" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <!-- RSS 订阅 -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="九溪 · 更新"
      href={withBase('/rss.xml')}
    />
    <!-- 安全响应头兜底（GitHub Pages 不读 _headers，故此处用 meta 覆盖） -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://cors.proxy.run https://api.codetabs.com https://api.allorigins.win https://corsproxy.io https://hn.algolia.com; base-uri 'self'; form-action 'self'"
    />
    <!-- 防闪烁：CSS 加载前先按已存主题（或系统偏好）设置 data-theme -->
    <script is:inline>
      (function () {
        try {
          let t = localStorage.getItem('jiuxi-theme');
          if (!t) {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'midnight'
              : 'chenxi';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch {
          /* 隐私模式等无法读取 localStorage 时忽略 */
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header glass">
      <a class="brand" href={withBase('/')}>九溪</a>
      <ThemeSwitcher />
    </header>
    <SiteNav />
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">九溪 · 综合信息聚集地</footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
  }
  body {
    min-height: 100vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background: linear-gradient(135deg, var(--bg-from), var(--bg-via) 50%, var(--bg-to));
    background-attachment: fixed;
    color: var(--text-strong);
    font-family: system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    transition: background 0.45s ease, color 0.45s ease;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 12px;
    padding: 10px 18px;
  }
  .brand {
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: 0.12em;
    color: var(--text-strong);
    text-decoration: none;
  }
  .site-main {
    flex: 1;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 16px 32px;
    box-sizing: border-box;
  }
  .site-footer {
    text-align: center;
    padding: 20px;
    color: var(--text-muted);
    font-size: 0.8rem;
  }
</style>
