---
// 九溪 · 基础布局（液态玻璃外壳）
// Phase 0：先提供「渐变背景 + 居中玻璃卡」的最简外壳；
// Phase 1 将在此加入 <head> 防闪烁脚本、主题切换器、站点导航。
import '../styles/global.css';
import '../styles/glass.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '九溪',
  description = '九溪 · 综合信息聚集地（AI 为主，热点新闻为辅）',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main class="jiuxi-shell">
      <section class="glass jiuxi-card">
        <slot />
      </section>
    </main>
  </body>
</html>

<style>
  html,
  body {
    height: 100%;
    margin: 0;
  }

  .jiuxi-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    box-sizing: border-box;
    background: linear-gradient(135deg, var(--bg-from), var(--bg-via) 50%, var(--bg-to));
    font-family: system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    color: var(--text-strong);
  }

  .jiuxi-card {
    width: min(520px, 100%);
    padding: 44px 32px;
    text-align: center;
  }
</style>
